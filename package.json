{
  "name": "thanksgiving-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "synth": "cdk synth"
  },
  "jest": {
    "testRegex": ".*\\.test\\.js$",
    "modulePathIgnorePatterns": [
      "<rootDir>/cdk.out/",
      "<rootDir>/build/"
    ],
    "transform": {}
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.8.1",
    "jest": "^30.5.2",
    "prettier": "^3.3.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "printWidth": 120
  }
}
